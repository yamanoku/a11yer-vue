{
  "name": "a11yer-vue",
  "version": "0.1.0",
  "description": "Vue 3 library for automatic accessibility (a11y) adjustment",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yamanoku/a11yer-vue"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint 'src/**/*.ts'",
    "lint:fix": "oxlint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^20.8.9",
    "oxlint": "1.58.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "vue": "^3.5.0"
  },
  "keywords": [
    "vue",
    "accessibility",
    "a11y",
    "wcag",
    "contrast",
    "aria",
    "focus-management"
  ],
  "license": "MIT",
  "sideEffects": false
}
